---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const contextLabel = {
  work: 'Work',
  personal: 'Personal project',
  school: 'School',
  hackathon: 'Hackathon',
  company: 'Company',
}[d.context];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': d.links.repo ? 'SoftwareSourceCode' : 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(d.links.repo && { codeRepository: `https://github.com/${d.links.repo}` }),
  ...(d.links.live && { url: d.links.live }),
};
---

<Base title={d.title} description={d.summary} jsonLd={jsonLd}>
  <article>
    <section class="narrow">
      <p class="meta crumb"><a href="/work/">Work</a> / {contextLabel}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <dl class="facts meta">
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Status</dt><dd>{d.status}</dd></div>
        <div><dt>Stack</dt><dd><ul class="chips">{d.stack.map((x) => <li>{x}</li>)}</ul></dd></div>
        {(d.links.live || d.links.repo) && (
          <div>
            <dt>Links</dt>
            <dd>
              {d.links.live && <a href={d.links.live}>{new URL(d.links.live).host}{new URL(d.links.live).pathname.replace(/\/$/, '')} ↗</a>}
              {d.links.live && d.links.repo && ' · '}
              {d.links.repo && <a href={`https://github.com/${d.links.repo}`}>GitHub ↗</a>}
            </dd>
          </div>
        )}
      </dl>
    </section>

    {d.cover && (
      <figure class="wide">
        <Image src={d.cover.src} alt={d.cover.alt} widths={[640, 880, 1440]} sizes="(max-width: 920px) 100vw, 880px" loading="eager" />
        {d.cover.caption && <figcaption>{d.cover.caption}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="next" aria-label="Next project">
    <a href={`/work/${next.id}/`}>
      <span class="meta">Next project</span>
      <span class="t">{next.data.title} <span aria-hidden="true">→</span></span>
      <span class="muted s">{next.data.summary}</span>
    </a>
  </nav>
</Base>

<style>
  .crumb { margin-bottom: 14px; }
  .crumb a { text-decoration: none; color: var(--accent); }
  h1 { font-size: clamp(40px, 6vw, 60px); line-height: 1.04; letter-spacing: -0.025em; }
  .lede { margin-top: 16px; font-size: 20px; line-height: 31px; color: var(--muted); }
  .facts {
    margin: 36px 0 0;
    padding: 6px 20px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .facts > div:first-child { border-top: 0; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; color: var(--text); }
  .facts dd a { color: var(--accent); }
  .facts .chips li { background: var(--card); }
  .prose { margin-top: 48px; }
  .prose > :global(h2:first-child) { margin-top: 0; }
  .next { margin-top: 96px; max-width: var(--measure); }
  .next a {
    display: grid;
    gap: 4px;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition: border-color 160ms ease-out, box-shadow 160ms ease-out;
  }
  .next a:hover { border-color: var(--rule-strong); box-shadow: var(--shadow); color: inherit; }
  .next a:hover .t { color: var(--accent); }
  .next .t { font: 500 26px/32px var(--serif); }
  .next .s { font-size: 15px; line-height: 24px; }
</style>
