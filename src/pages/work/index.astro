---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { archive } from '../../data/archive';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const main = all.filter((p) => p.data.tier === 1);
const more = all.filter((p) => p.data.tier === 2);
---

<Base title="Work" description="Projects by Matthew Macri: MotoRoute Pro, KernelOp, Tokidos, a self-hosted server, and smaller work from school and hackathons.">
  <section>
    <p class="meta kicker">{all.length} projects · {archive.length} archived</p>
    <h1>Work</h1>
    <p class="muted intro">
      The main projects first, then smaller ones, then school work. Each one has its own page with how it was built.
      Work I did for employers is described but not linked.
    </p>
  </section>

  <section aria-labelledby="main-h">
    <SectionHead id="main-h" num="01" title="Main projects" />
    <ul class="plain grid two">{main.map((p) => <ProjectCard project={p} />)}</ul>
  </section>

  <section aria-labelledby="more-h">
    <SectionHead id="more-h" num="02" title="Smaller projects" />
    <ul class="plain grid three">{more.map((p) => <ProjectCard project={p} size="compact" />)}</ul>
  </section>

  <section aria-labelledby="archive-h">
    <SectionHead id="archive-h" num="03" title="Archive" />
    <p class="muted small">Coursework and early projects, kept for the record.</p>
    <table class="archive">
      <thead>
        <tr>
          <th scope="col">Year</th>
          <th scope="col">Project</th>
          <th scope="col" class="hide-sm">Made for</th>
          <th scope="col"><span class="visually-hidden">Link</span></th>
        </tr>
      </thead>
      <tbody>
        {archive.map((a) => (
          <tr>
            <td class="meta">{a.year}</td>
            <td>
              {a.name}
              <div class="muted small">{a.what}</div>
              <div class="meta">{a.stack}</div>
            </td>
            <td class="hide-sm muted small">{a.context}</td>
            <td>{a.repo && <a class="meta" href={`https://github.com/${a.repo}`} aria-label={`${a.name} on GitHub`}>↗</a>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<style>
  .kicker { color: var(--accent); margin-bottom: 12px; }
  h1 { font-size: clamp(44px, 7vw, 72px); line-height: 1; letter-spacing: -0.03em; }
  .intro { margin-top: 20px; font-size: 19px; line-height: 30px; max-width: 34em; }
  .grid { display: grid; gap: 20px; }
  .two { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 960px) { .three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) { .two, .three { grid-template-columns: 1fr; } }
  .archive { margin-top: 16px; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
