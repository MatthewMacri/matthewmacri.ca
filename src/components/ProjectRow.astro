---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../data/site';
import github from '../data/github.json';

interface Props {
  project: CollectionEntry<'projects'>;
  lang?: Lang;
}

const { project, lang = 'en' } = Astro.props;
const d = project.data;
const summary = lang === 'fr' && d.summaryFr ? d.summaryFr : d.summary;
const out = d.links.live ?? (d.links.repo ? `https://github.com/${d.links.repo}` : undefined);
const outLabel = d.links.live ? new URL(d.links.live).hostname.replace(/^www\./, '') : 'GitHub';
const gh = d.links.repo ? (github as Record<string, { stars: number; pushed: string }>)[d.links.repo] : undefined;
const year = d.year.split(/\s*[–-]\s*/)[0];
---

<li class="row">
  <span class="when meta">{year}</span>
  <div>
    <div class="title"><a href={`/work/${project.id}/`} lang={lang === 'fr' ? 'en' : undefined}>{d.title}</a></div>
    <p class="desc">{summary}</p>
    <div class="stack meta">
      {d.stack.slice(0, 4).join(' · ')}
      {gh && gh.stars > 0 && <> · ★ {gh.stars}</>}
    </div>
  </div>
  {out && (
    <a class="out meta" href={out} aria-label={`${d.title} on ${outLabel}`} title={outLabel}>↗</a>
  )}
</li>
