---
import Base from '../layouts/Base.astro';
import Experience from './Experience.astro';
import SectionHead from './SectionHead.astro';
import { education, extras } from '../data/experience';
import { site, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fr = lang === 'fr';
---

<Base
  lang={lang}
  title={fr ? 'À propos' : 'About'}
  alternate={fr ? '/about/' : '/fr/about/'}
  description={fr
    ? 'Qui je suis, où j’ai travaillé et ce que j’étudie.'
    : 'Who I am, where I’ve worked and what I’m studying.'}
>
  <section class="top">
    <p class="meta kicker">{fr ? 'À propos' : 'About'}</p>
    <h1>{fr ? 'Développeur, étudiant en génie, et un peu sysadmin.' : 'Developer, engineering student, part-time sysadmin.'}</h1>
    <div class="split">
    <div class="bio">
    {fr ? (
      <>
        <p>
          Je suis basé à Montréal. J’ai fait mon DEC en informatique à Vanier, et je commence
          maintenant un baccalauréat en génie informatique à Concordia.
        </p>
        <p>
          En parallèle, je travaille chez Tokidos, où j’ai commencé au soutien technique et où je suis maintenant
          développeur, et je m’occupe du site web d’Euro Gear. J’ai aussi fondé KernelOp, un petit studio qui fait des
          sites et des outils pour d’autres entreprises.
        </p>
        <p>
          La plupart de mes projets personnels roulent sur un serveur que j’administre moi-même, y compris ce site. J’aime avoir la
          main sur toute la chaîne, du code jusqu’au DNS.
        </p>
      </>
    ) : (
      <>
        <p>
          I’m based in Montréal. I did my DEC in Computer Science at Vanier and have just
          started a Computer Engineering degree at Concordia.
        </p>
        <p>
          Alongside school I work at Tokidos, where I started in support and am now a developer, and I look after
          the Euro Gear website. I also started KernelOp, a small studio that builds sites and tools for other
          businesses.
        </p>
        <p>
          Most of my own projects run on a server I look after myself, this site included. I like owning the whole path, from
          the code down to DNS.
        </p>
      </>
    )}
    </div>
    <aside class="facts" aria-label={fr ? 'En bref' : 'At a glance'}>
      <dl>
        <div><dt class="meta">{fr ? 'Basé à' : 'Based in'}</dt><dd>Montréal, QC</dd></div>
        <div><dt class="meta">{fr ? 'Études' : 'Studying'}</dt><dd>{fr ? 'Génie informatique, Concordia' : 'Computer Engineering, Concordia'}</dd></div>
        <div><dt class="meta">{fr ? 'Travail' : 'Working at'}</dt><dd>Tokidos · Euro Gear</dd></div>
        <div><dt class="meta">{fr ? 'Fondateur' : 'Founder'}</dt><dd><a href={site.kernelop}>KernelOp</a></dd></div>
        <div><dt class="meta">{fr ? 'Langues' : 'Languages'}</dt><dd>{extras.languages[lang]}</dd></div>
      </dl>
      <a class="btn primary" href={`mailto:${site.email}`}>{fr ? 'M’écrire' : 'Get in touch'}</a>
    </aside>
    </div>
  </section>

  <section aria-labelledby="exp">
    <SectionHead id="exp" num="01" title={fr ? 'Expérience' : 'Experience'} />
    <Experience lang={lang} />
  </section>

  <section aria-labelledby="edu">
    <SectionHead id="edu" num="02" title={fr ? 'Études' : 'Education'} />
    <ul class="plain edu">
      {education.map((e) => (
        <li>
          <span class="meta">{e.period[lang]}</span>
          <h3>{e.school}</h3>
          <p>{e.degree[lang]}</p>
          <p class="muted small">{e.note[lang]}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="else">
    <SectionHead id="else" num="03" title={fr ? 'Aussi' : 'Also'} />
    <dl class="also">
      <dt class="meta">{fr ? 'Hackathons' : 'Hackathons'}</dt>
      <dd>
        {extras.events.map((ev) => (
          <div>{ev.name} {ev.year} <span class="muted">· {ev.note[lang]}</span></div>
        ))}
      </dd>
      <dt class="meta">{fr ? 'Certificat' : 'Certificate'}</dt>
      <dd>{extras.certs.map((c) => <div>{c.name} <span class="muted">· {c.by}, {c.year}</span></div>)}</dd>
      <dt class="meta">{fr ? 'Langues' : 'Languages'}</dt>
      <dd>{extras.languages[lang]}</dd>
      <dt class="meta">{fr ? 'Joindre' : 'Contact'}</dt>
      <dd>
        <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.github}>GitHub</a> ·{' '}
        <a href={site.linkedin}>LinkedIn</a>
      </dd>
    </dl>
  </section>
</Base>

<style>
  .kicker { color: var(--accent); margin-bottom: 12px; }
  .top h1 { font-size: clamp(36px, 5.5vw, 56px); line-height: 1.08; letter-spacing: -0.025em; max-width: 16em; }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
    margin-top: 40px;
    align-items: start;
  }
  .bio { font-size: 18px; line-height: 30px; max-width: var(--measure); }
  .bio p:first-child::first-line { font-weight: 500; }
  .facts {
    position: sticky;
    top: 88px;
    padding: 22px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
  }
  .facts dl { margin: 0 0 20px; }
  .facts dl > div { padding: 10px 0; border-top: 1px solid var(--rule); }
  .facts dl > div:first-child { border-top: 0; padding-top: 0; }
  .facts dd { margin: 2px 0 0; font-weight: 500; }
  .facts .btn { width: 100%; justify-content: center; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: 32px; }
    .facts { position: static; }
  }

  .edu { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .edu li {
    padding: 22px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
  }
  .edu h3 { margin: 6px 0 6px; }
  .edu p { margin: 0 0 6px; }
  @media (max-width: 760px) {
    .edu { grid-template-columns: 1fr; }
  }

  .also {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 14px 20px;
    margin: 0;
    max-width: 820px;
  }
  .also dt { padding-top: 4px; }
  .also dd { margin: 0; }
  @media (max-width: 600px) {
    .also { grid-template-columns: 1fr; gap: 2px; }
    .also dd { margin-bottom: 12px; }
  }
</style>
